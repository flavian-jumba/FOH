# Public Supabase settings. For this Vite app, either VITE_* or NEXT_PUBLIC_* names work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used only by the browser when using the VITE_* naming convention.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Paystack. The secret key is server-only: set it with `supabase secrets set PAYSTACK_SECRET_KEY=...`
# and never give it a VITE_ or NEXT_PUBLIC_ prefix. The public key is not needed by the current
# checkout (the server creates the transaction) but is kept here for reference.
PAYSTACK_SECRET_KEY=sk_test_xxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Which currencies the donation form offers, first one being the default. This is a Supabase
# Edge Function secret, not a browser setting: `supabase secrets set DONATION_CURRENCIES=USD,KES`.
# Leave it unset (shillings only) until Paystack has enabled USD for the business.
DONATION_CURRENCIES=KES

# Also an Edge Function secret. While dollars are not enabled above, the form shows dollar amounts
# and charges the same value in shillings at this rate (shillings per dollar). Leave it unset to
# use the day's market rate, or set it to `off` to show shillings only.
# USD_KES_RATE=129.5
