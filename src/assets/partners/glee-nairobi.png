hero__subtitle wa-headline-font js-shuffle-element-title" > &nbsp </div> <svg xmlns="http://www.w3.org/2000/svg" class="glee-decor" width="9" height="49" viewBox="0 0 9 49" fill="none"> <line x1="4.5" y1="48.3853" x2="4.5" y2="7.38525" stroke="#917248"/> <line x1="0.5" y1="41.3853" x2="0.500002" y2="0.385254" stroke="#917248"/> <line x1="8.5" y1="41.3853" x2="8.5" y2="0.385254" stroke="#917248"/> </svg> </div> </div> </section> </div><div data-component-id='21496359' > <section class="l-section l-section--intro-text"> <svg xmlns="http://www.w3.org/2000/svg" class="glee-decor" width="9" height="49" viewBox="0 0 9 49" fill="none"> <line x1="4.5" y1="48.3853" x2="4.5" y2="7.38525" stroke="#917248"/> <line x1="0.5" y1="41.3853" x2="0.500002" y2="0.385254" stroke="#917248"/> <line x1="8.5" y1="41.3853" x2="8.5" y2="0.385254" stroke="#917248"/> </svg> <div class="l-wrapper "> <div class="intro-text"> <div class="intro-text__content wa-headline-font" > <h2><big><span id="ixsld4" style="font-size:38px;"><span id="iqgrgj" style="color:#917248;">A Proudly Independent Luxury Hotel</span></span></big></h2> <p>Set across eight acres of lush landscaped grounds, Glee Nairobi is designed for business, events, and refined stays — offering expansive meeting spaces, distinctive dining, and resort-style calm within the city.</p> </div> <a class="intro-text__btn site-btn wa-primary-border-color wa-primary-color wa-primary-background-color--hover" href='https://www.youtube.com/watch?v=h902h-DTYSQ&t=12s' target='_blank' > <span class="text" > WATCH HOTEL FILM </span> </a> </div> </div> </section> </div><div data-component-id='21496361' > <section class="l-section l-section--text-on-photo-background"> <div class="text-on-photo-background "> <div class="text-on-photo-background__background-image-hld"> <div class="text-on-photo-background__img-hld" > <div class="text-on-photo-background__img-inner "> <picture class="cvr-pic"> <source type="image/webp" srcset="/templates/thegleehotel/images/img-blank.gif" media="(max-width: 767px)" data-srcset="https://wa-uploads.profitroom.com/thegleehotel/767x767/17316675583616_.nightwideparkingperspective.webp"> <source srcset="/templates/thegleehotel/images/img-blank.gif" media="(max-width: 767px)" data-srcset="https://wa-uploads.profitroom.com/thegleehotel/767x767/17316675583616_nightwideparkingperspective.jpg"> <source type="image/webp" srcset="/templates/thegleehotel/images/img-blank.gif" media="(max-width: 1239px)" data-srcset="https://wa-uploads.profitroom.com/thegleehotel/1239x650/17316675583616_.nightwideparkingperspective.webp"> <source srcset="/templates/thegleehotel/images/img-blank.gif" media="(max-width: 1239px)" data-srcset="https://wa-uploads.profitroom.com/thegleehotel/1239x650/17316675583616_nightwideparkingperspective.jpg"> <source type="image/webp" srcset="/templates/thegleehotel/images/img-blank.gif" media="(max-width: 1366px)" data-srcset="https://wa-uploads.profitroom.com/thegleehotel/1366x750/17316675583616_.nightwideparkingperspective.webp"> <source srcset="/templates/thegleehotel/images/img-blank.gif" media="(max-width: 1366px)" data-srcset="https://wa-uploads.profitroom.com/thegleehotel/1366x750/17316675583616_nightwideparkingperspective.jpg"> <source type="image/webp" srcset="/templates/thegleehotel/images/img-blank.gif" data-srcset="https://wa-uploads.profitroom.com/thegleehotel/1920x1150/17316675583616_.nightwideparkingperspective.webp"> <img class="text-on-photo-background__image cvr-pic__img js-lazy" src="/templates/thegleehotel/images/img-blank.gif" data-src="https://wa-uploads.profitroom.com/thegleehotel/1920x1150/17316675583616_nightwideparkingperspective.jpg" alt=""> </picture> </div> </div> </div> <div class="text-on-photo-background__content-hld "> <div class="text-on-photo-background__title t-section-title wa-headline-font" > Location </div> <div class="text-on-photo-background__subtitle t-section-subtitle t-section-subtitle--big" > Our 211-room hotel sits close to the United Nations and Nairobi’s diplomatic district, with easy access to Village Market, Karura Forest, the city’s leading golf courses and nearby coffee farms for guests to explore — bringing business, lifestyle, and outdoor experiences within easy reach. </div> </div> </div> </section> </div><div data-component-id='21496363' > <section class="l-section l-section--rooms-slider js-rooms-slider-holder"> <div class="l-wrapper l-wrapper--hd"> <div class="rooms-slider"> <div class="rooms-slider__top"> <div class="rooms-slider__title-box"> <h2 class="rooms-slider__title t-section-title wa-headline-font js-shuffle-element-title" > Rooms & Suites </h2> <div class="rooms-slider__subtitle t-section-subtitle" > Each guest room is exquisitely designed and expressive </div> </div> <div class="rooms-slider__btn-box"> <a class="rooms-slider__btn btn-link wa-primary-color wa-secondary-color--hover" href="/rooms-suites"> <span class="text"> See all rooms </span> </a> </div> <svg xmlns="http://www.w3.org/2000/svg" class="glee-decor" width="9" height="49" viewBox="0 0 9 49" fill="none"> <line x1="4.5" y1="48.3853" x2="4.5" y2="7.38525" stroke="#917248"/> <line x1="0.5" y1="41.3853" x2="0.500002" y2="0.385254" stroke="#917248"/> <line x1="8.5" y1="41.3853" x2="8.5" y2="0.385254" stroke="#917248"/> </svg> </div> </div> </div> <div class="rooms-slider__wrapper"> <div class="rooms-slider js-rooms-slider-holder"> <div class="rooms-slider__container swiper-container js-rooms-slider"> <div class="swiper-wrapper"> <a href="https://www.gleenairobi.com/rooms-suites/superior-room" data-menu-page="1824657" class="room-item-card room-item-card--slider swiper-slide " data-category="" aria-label="Superior Room see details"> <div class="room-item-card__inner"> <div class="room-item-card__img-box "> <div class="room-item-card__img-outer js-room-item-hld "> <picture class="room-item-card__img-hld cvr-pic"> <source srcset="/templates/thegleehotel/images/img-blank.gif" data-srcset="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/06cd0929-8278-428d-9816-ad28bdc55b13.jpg?updated=2026-02-24_13-11?updated=2026-02-24_13-11"/> <img id="room-img-45225" class="room-item-card__img cvr-pic__img js-lazy " src="/templates/thegleehotel/images/img-blank.gif" data-src="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/06cd0929-8278-428d-9816-ad28bdc55b13.jpg?updated=2026-02-24_13-11?updated=2026-02-24_13-11" alt="Superior Room"> </picture> </div> </div> <div class="room-item-card__text-box "> <div class="room-item-card__text-box-inner"> <div class="room-item-card__title-hld"> <div class="room-item-card__title wa-headline-font t-section-title t-section-title--medium wa-headline-font"> Superior Room </div> </div> <div class="room-item-card__special-info "> <div class="room-item-card__special-info-item "> <span class="icon icon-expand" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 32 m<sup>2</sup> </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-os"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> maximum 2 people </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-bed" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 1x King Size Bed, 2x Twin Beds </span> </div> </div> </div> <div class="room-item-card__description t-content"> Delight in our exquisitely designed Superior Rooms which feature a relaxing king size bed, a comfortable working desk, a plush bathroom, large windows inviting natural light &amp; captivating views of your choi... </div> </div> <div class="room-item-card__buttons "> <button class='room-item-card__booking-btn room-item-card__booking-btn--details btn-link wa-primary-color wa-secondary-color--hover' aria-hidden="true" tabindex="-1"> <span class="text wa-paragraph-font" >Details</span> </button> <button class='room-item-card__booking-btn room-item-card__booking-btn--book btn-link wa-primary-color wa-secondary-color--hover js-room-booking-button' data-link="https://be.synxis.com/?Chain=10237&Hotel=44589&level=hotel"> <span class="text wa-paragraph-font" >Book online</span> </button> </div> </div> </div> </a> <a href="https://www.gleenairobi.com/rooms-suites/superior-terrace-room" data-menu-page="1824659" class="room-item-card room-item-card--slider swiper-slide " data-category="" aria-label="Superior-Terrace Room see details"> <div class="room-item-card__inner"> <div class="room-item-card__img-box "> <div class="room-item-card__img-outer js-room-item-hld "> <picture class="room-item-card__img-hld cvr-pic"> <source srcset="/templates/thegleehotel/images/img-blank.gif" data-srcset="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/76d826bc-b598-4d8c-b9fb-6ec2eff64e38.jpg?updated=2026-02-24_13-11?updated=2026-02-24_13-11"/> <img id="room-img-45227" class="room-item-card__img cvr-pic__img js-lazy " src="/templates/thegleehotel/images/img-blank.gif" data-src="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/76d826bc-b598-4d8c-b9fb-6ec2eff64e38.jpg?updated=2026-02-24_13-11?updated=2026-02-24_13-11" alt="Superior-Terrace Room"> </picture> </div> </div> <div class="room-item-card__text-box "> <div class="room-item-card__text-box-inner"> <div class="room-item-card__title-hld"> <div class="room-item-card__title wa-headline-font t-section-title t-section-title--medium wa-headline-font"> Superior-Terrace Room </div> </div> <div class="room-item-card__special-info "> <div class="room-item-card__special-info-item "> <span class="icon icon-expand" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 32 m<sup>2</sup> </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-os"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> maximum 2 people </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-bed" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 1x King Size Bed, 2x Twin Beds </span> </div> </div> </div> <div class="room-item-card__description t-content"> Unwind and take in the beauty of your surroundings in our Superior -Terrace Rooms. These beautiful rooms offer a calming outdoor seating terrace, providing additional space to wind down. </div> </div> <div class="room-item-card__buttons "> <button class='room-item-card__booking-btn room-item-card__booking-btn--details btn-link wa-primary-color wa-secondary-color--hover' aria-hidden="true" tabindex="-1"> <span class="text wa-paragraph-font" >Details</span> </button> <button class='room-item-card__booking-btn room-item-card__booking-btn--book btn-link wa-primary-color wa-secondary-color--hover js-room-booking-button' data-link="https://be.synxis.com/?Chain=10237&Hotel=44589&level=hotel"> <span class="text wa-paragraph-font" >Book online</span> </button> </div> </div> </div> </a> <a href="https://www.gleenairobi.com/rooms-suites/deluxe-room" data-menu-page="1824661" class="room-item-card room-item-card--slider swiper-slide " data-category="" aria-label="Deluxe Room see details"> <div class="room-item-card__inner"> <div class="room-item-card__img-box "> <div class="room-item-card__img-outer js-room-item-hld "> <picture class="room-item-card__img-hld cvr-pic"> <source srcset="/templates/thegleehotel/images/img-blank.gif" data-srcset="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/a1ddbcef-45e9-4400-95a0-d515f19925b8.jpg?updated=2026-02-24_13-12?updated=2026-02-24_13-12"/> <img id="room-img-45229" class="room-item-card__img cvr-pic__img js-lazy " src="/templates/thegleehotel/images/img-blank.gif" data-src="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/a1ddbcef-45e9-4400-95a0-d515f19925b8.jpg?updated=2026-02-24_13-12?updated=2026-02-24_13-12" alt="Deluxe Room"> </picture> </div> </div> <div class="room-item-card__text-box "> <div class="room-item-card__text-box-inner"> <div class="room-item-card__title-hld"> <div class="room-item-card__title wa-headline-font t-section-title t-section-title--medium wa-headline-font"> Deluxe Room </div> </div> <div class="room-item-card__special-info "> <div class="room-item-card__special-info-item "> <span class="icon icon-expand" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 50 m<sup>2</sup> </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-os"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> maximum 3 people </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-bed" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 1x King Size Bed, 2x Twin Beds </span> </div> </div> </div> <div class="room-item-card__description t-content"> Indulge in our Deluxe Rooms, great for guests who are looking for a bit more space for added comfort &amp; flexibility. Ideal for accommodating an extra guest. </div> </div> <div class="room-item-card__buttons "> <button class='room-item-card__booking-btn room-item-card__booking-btn--details btn-link wa-primary-color wa-secondary-color--hover' aria-hidden="true" tabindex="-1"> <span class="text wa-paragraph-font" >Details</span> </button> <button class='room-item-card__booking-btn room-item-card__booking-btn--book btn-link wa-primary-color wa-secondary-color--hover js-room-booking-button' data-link="https://be.synxis.com/?Chain=10237&Hotel=44589&level=hotel"> <span class="text wa-paragraph-font" >Book online</span> </button> </div> </div> </div> </a> <a href="https://www.gleenairobi.com/rooms-suites/junior-suite" data-menu-page="1824665" class="room-item-card room-item-card--slider swiper-slide " data-category="" aria-label="Junior Suite see details"> <div class="room-item-card__inner"> <div class="room-item-card__img-box "> <div class="room-item-card__img-outer js-room-item-hld "> <picture class="room-item-card__img-hld cvr-pic"> <source srcset="/templates/thegleehotel/images/img-blank.gif" data-srcset="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/c4b93363-ade3-4f76-b4b6-be432780bb2b.jpg?updated=2026-02-24_13-12?updated=2026-02-24_13-12"/> <img id="room-img-45233" class="room-item-card__img cvr-pic__img js-lazy " src="/templates/thegleehotel/images/img-blank.gif" data-src="https://r.profitroom.com/thegleehotel/images/rooms/thumbs/1040x680/c4b93363-ade3-4f76-b4b6-be432780bb2b.jpg?updated=2026-02-24_13-12?updated=2026-02-24_13-12" alt="Junior Suite"> </picture> </div> </div> <div class="room-item-card__text-box "> <div class="room-item-card__text-box-inner"> <div class="room-item-card__title-hld"> <div class="room-item-card__title wa-headline-font t-section-title t-section-title--medium wa-headline-font"> Junior Suite </div> </div> <div class="room-item-card__special-info "> <div class="room-item-card__special-info-item "> <span class="icon icon-expand" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 59 m<sup>2</sup> </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-os"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> maximum 3 people </span> </div> </div> <div class="room-item-card__special-info-item "> <span class="icon icon-bed" aria-hidden="true"></span> <div class="room-item-card__special-info-text"> <span class="text t-content"> 1x King Size Bed </span> </div> </div> </div> <div class="room-item-card__description t-content"> Enjoy an indulgent experience of spacious luxury in these thoughtfully designed rooms with beautiful amenities and our delightful personalised service. Great